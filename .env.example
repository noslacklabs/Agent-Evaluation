# Frontend and API
FRONTEND_ORIGIN=http://localhost:5173
VITE_EVALUATOR_API_URL=http://localhost:8002/api

# DeepEval judge model. Gemini supports a free usage tier subject to Google's limits.
DEEPEVAL_JUDGE_MODEL=gemini-2.5-flash
USE_GEMINI_MODEL=1
GEMINI_MODEL_NAME=gemini-2.5-flash
GOOGLE_API_KEY=

# Optional. If omitted, a local key is generated under backend/data.
EVALUATOR_ENCRYPTION_KEY=
EVALUATOR_MAX_UPLOAD_BYTES=26214400
EVALUATOR_AGENT_TIMEOUT_SECONDS=90
EVALUATOR_PYTHON_TIMEOUT_SECONDS=120
